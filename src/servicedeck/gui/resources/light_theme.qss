/* ═══════════════════════════════════════════════════════════════════
   ServiceDeck — Crisp Daylight Slate Light Theme
   ═══════════════════════════════════════════════════════════════════ */

QMainWindow, QDialog, QMessageBox, QInputDialog {
    background-color: #FFFFFF;
    color: #0F172A;
    font-family: "Inter", "Plus Jakarta Sans", "Noto Sans", "Segoe UI", sans-serif;
    font-size: 13px;
}

QWidget {
    color: #0F172A;
    font-family: "Inter", "Plus Jakarta Sans", "Noto Sans", "Segoe UI", sans-serif;
    font-size: 13px;
}

QScrollArea, QStackedWidget {
    background-color: #FFFFFF;
    border: none;
}

/* ─── Left Host & Scope Sidebar ─── */
QWidget#hostSidebar {
    background-color: #F1F5F9;
    border-right: 1px solid #E2E8F0;
}

QScrollArea#hostsScroll,
QWidget#hostsViewport,
QWidget#hostsContainer {
    background-color: transparent;
    border: none;
}

QLabel#brandTitle {
    color: #0F172A;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.2px;
}

QLabel#sidebarSectionLabel {
    color: #64748B;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    padding: 4px 8px 2px 8px;
}

QWidget#scopeSegmented {
    background-color: #E2E8F0;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}

QPushButton#scopeBtn {
    background-color: transparent;
    color: #475569;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#scopeBtn:hover {
    color: #0F172A;
    background-color: rgba(255, 255, 255, 0.5);
}

QPushButton#scopeBtn:checked {
    background-color: #FFFFFF;
    color: #2563EB;
}

QListWidget#hostList {
    background-color: transparent;
    border: none;
    outline: none;
}

QWidget#hostItemRow[active="true"] {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}

QPushButton#hostRowSelectBtn {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 7px 8px;
    border-radius: 8px;
    color: #334155;
    font-weight: 500;
}

QPushButton#hostRowSelectBtn:hover {
    background-color: rgba(255, 255, 255, 0.65);
    color: #0F172A;
}

QPushButton#hostRowSelectBtn[active="true"] {
    color: #2563EB;
    font-weight: 600;
}

QPushButton#hostRowMenuBtn {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QPushButton#hostRowMenuBtn:hover {
    background-color: #E2E8F0;
}

QPushButton#sidebarGhostBtn {
    background-color: transparent;
    color: #475569;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 7px 10px;
    text-align: left;
    font-weight: 500;
}

QPushButton#sidebarGhostBtn:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}

QPushButton#adminSessionButton {
    background-color: #FEF3C7;
    color: #B45309;
    border: 1px solid #FDE68A;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}

QPushButton#adminSessionButton:hover {
    background-color: #FDE68A;
}

/* ─── Workspace Header & Filter Bar ─── */
QWidget#workspaceHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

QLabel#contextTitle {
    color: #0F172A;
    font-size: 17px;
    font-weight: 700;
}

QLabel#contextSubtitle {
    color: #64748B;
    font-size: 12px;
}

QLabel#liveIndicator {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#filterChip,
QPushButton#filterChipFailed {
    background-color: #F8FAFC;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 5px 12px;
    min-height: 20px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#filterChip:hover,
QPushButton#filterChipFailed:hover {
    background-color: #F1F5F9;
    color: #0F172A;
    border-color: #CBD5E1;
}

QPushButton#filterChip:checked {
    background-color: #EFF6FF;
    color: #2563EB;
    border-color: #2563EB;
}

QPushButton#filterChipFailed:checked {
    background-color: #FEE2E2;
    color: #B91C1C;
    border-color: #EF4444;
}

/* ─── Inputs ─── */
QLineEdit, QComboBox, QTextEdit, QSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 7px 10px;
    min-height: 20px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

QLineEdit[invalid="true"],
QLineEdit[invalid="true"]:focus {
    border: 1px solid #EF4444;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QSpinBox:focus {
    border: 1px solid #2563EB;
}

QLineEdit#searchEdit {
    background-color: #F8FAFC;
    border-radius: 8px;
    padding: 7px 12px;
}

QLineEdit#searchEdit:focus {
    background-color: #FFFFFF;
}

QComboBox {
    padding-right: 26px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}

QComboBox::down-arrow {
    image: url(":/assets/down-arrow.svg");
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    outline: none;
}

/* ─── Checkboxes ─── */
QCheckBox {
    color: #334155;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #94A3B8;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

/* ─── Service Table ─── */
QTableView#serviceTable, QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAFBFD;
    color: #0F172A;
    border: none;
    outline: none;
    selection-background-color: #EFF6FF;
    selection-color: #0F172A;
}

QTableView#serviceTable::item {
    border-bottom: 1px solid #F1F5F9;
}

QTableView#serviceTable::item:hover {
    background-color: #F8FAFC;
}

QTableView#serviceTable::item:selected {
    background-color: #EFF6FF;
}

QHeaderView::section {
    background-color: #FFFFFF;
    color: #64748B;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid #E2E8F0;
}

/* ─── Right Inspector Panel ─── */
QWidget#detailPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #E2E8F0;
}

QWidget#inspectorHeader {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}

QScrollArea#inspectorScroll,
QWidget#inspectorViewport,
QWidget#overviewPage,
QWidget#logsPage,
QWidget#unitFilePage {
    background-color: #FFFFFF;
    border: none;
}

QTextEdit#serviceLogViewer, QTextEdit#unitFileViewer {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QLabel#inspectorTitle {
    color: #0F172A;
    font-size: 15px;
    font-weight: 700;
}

QLabel#inspectorDesc {
    color: #475569;
    font-size: 12px;
}

QLabel#statusPill {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
}

QFrame#metricCard {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QLabel#metricLabel {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
}

QLabel#metricValue {
    color: #0F172A;
    font-size: 15px;
    font-weight: 700;
}

QFrame#propGroup {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QLabel#propKey {
    color: #64748B;
    font-size: 12px;
    font-weight: 600;
}

QLabel#propVal {
    color: #0F172A;
    font-size: 12px;
}

/* ─── Tabs ─── */
QTabWidget#detailTabs::pane {
    border: none;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: transparent;
    color: #64748B;
    padding: 10px 14px;
    font-weight: 600;
    font-size: 12px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
}

QTabBar::tab:hover:!selected {
    color: #0F172A;
}

/* ─── Buttons ─── */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #F8FAFC;
    border-color: #94A3B8;
}

QPushButton:pressed {
    background-color: #F1F5F9;
}

QPushButton:disabled {
    color: #94A3B8;
    background-color: #F8FAFC;
    border-color: #E2E8F0;
}

QPushButton#primary {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    font-weight: 700;
}

QPushButton#primary:hover {
    background-color: #1D4ED8;
}

QPushButton#primary:disabled {
    background-color: #93C5FD;
    color: #FFFFFF;
}

QPushButton#successBtn {
    background-color: #DCFCE7;
    color: #15803D;
    border: 1px solid #BBF7D0;
}

QPushButton#successBtn:hover {
    background-color: #BBF7D0;
}

QPushButton#dangerBtn {
    background-color: #FEE2E2;
    color: #B91C1C;
    border: 1px solid #FECACA;
}

QPushButton#dangerBtn:hover {
    background-color: #FECACA;
}

QPushButton#iconBtn {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 6px 10px;
}

QPushButton#iconBtn:hover {
    background-color: #F1F5F9;
}

/* ─── Splitter ─── */
QSplitter::handle {
    background-color: #E2E8F0;
    width: 1px;
}

/* ─── Scrollbars ─── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0px;
    height: 0px;
}

/* ─── Menus & StatusBar ─── */
QMenuBar {
    qproperty-nativeMenuBar: false;
    background-color: #F1F5F9;
    color: #0F172A;
    border-bottom: 1px solid #E2E8F0;
}

QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
}

QStatusBar {
    background-color: #F8FAFC;
    color: #475569;
    border-top: 1px solid #E2E8F0;
    padding: 2px 10px;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
}

/* ─── Dialog Chrome & Non-Shifting Banners ─── */
QWidget#dialogHeader {
    background-color: #F8FAFC;
    border-bottom: 1px solid #E2E8F0;
}

QFrame#dialogCard {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QWidget#dialogFooter {
    background-color: #F8FAFC;
    border-top: 1px solid #E2E8F0;
}

QLabel#dialogBanner {
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 500;
}

QLabel#dialogBanner[state="error"] {
    background-color: #FEE2E2;
    color: #B91C1C;
    border: 1px solid #FECACA;
}

QLabel#dialogBanner[state="success"] {
    background-color: #DCFCE7;
    color: #15803D;
    border: 1px solid #BBF7D0;
}

QLabel#dialogBanner[state="info"] {
    background-color: #EFF6FF;
    color: #1D4ED8;
    border: 1px solid #BFDBFE;
}

QTextEdit#unitContentEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}
